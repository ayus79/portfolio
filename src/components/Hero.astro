<script>
  const roles = [
    'Backend Engineer',
    'Python Developer',
    'Scalable Systems Builder',
    'Problem Solver',
    'Tech Enthusiast',
    'System Designer',
    'Part-Time Gamer',
    'Traveler',
  ];

  let roleIndex = Math.floor(Math.random() * roles.length);
  let charIndex = 0;
  let deleting = false;
  const el = document.getElementById('typewriter')!;

  function tick() {
    const current = roles[roleIndex];
    el.textContent = deleting ? current.slice(0, charIndex--) : current.slice(0, charIndex++);

    if (!deleting && charIndex > current.length) {
      deleting = true;
      setTimeout(tick, 1800);
      return;
    }
    if (deleting && charIndex < 0) {
      deleting = false;
      let next = Math.floor(Math.random() * roles.length);
      if (next === roleIndex) next = (next + 1) % roles.length;
      roleIndex = next;
      charIndex = 0;
    }
    setTimeout(tick, deleting ? 50 : 80);
  }

  tick();
</script>
