---
const stats = [
  { value: '4+', label: 'Years Experience' },
  { value: '7+', label: 'Systems Developed' },
  { value: 'Backend', label: 'Core focus' },
];
---

<section
  id="about"
  class="relative min-h-[calc(100svh-3.5rem)] flex flex-col justify-center py-16 md:py-24"
>
  <!-- Soft green glow behind the hero -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-10 right-0 w-72 h-72 md:w-[28rem] md:h-[28rem] rounded-full bg-green-500/10 blur-3xl"
  ></div>

  <div class="relative grid lg:grid-cols-[1.35fr_1fr] gap-12 lg:gap-10 items-center">
    <!-- Left: intro -->
    <div>
      <!-- Terminal prompt line -->
      <p class="text-gray-500 text-xs sm:text-sm mb-5 md:mb-6">
        <span class="text-green-400">ayush@dev</span>:<span class="text-cyan-400">~</span>$ whoami
      </p>

      <!-- Name -->
      <h1
        class="text-4xl sm:text-5xl md:text-7xl font-bold text-white leading-[1.05] mb-5 animate-fade-up"
        style="animation-delay: 0.05s; opacity: 0; animation-fill-mode: forwards;"
      >
        <span class="block text-gray-500 text-2xl sm:text-3xl md:text-4xl font-medium mb-2">Hello, I'm</span>
        Ayush Contractor<span class="text-green-400">.</span>
      </h1>

      <!-- Role typewriter -->
      <div
        class="text-lg sm:text-xl md:text-2xl text-gray-400 mb-5 animate-fade-up"
        style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
      >
        <span class="text-green-400">&gt; </span>
        <span id="typewriter"></span><span class="animate-blink text-green-400">█</span>
      </div>

      <!-- Bio -->
      <p
        class="max-w-xl text-gray-400 text-sm sm:text-base leading-relaxed mb-8 animate-fade-up"
        style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;"
      >
        Backend-focused Software Engineer with strong expertise in Python and building scalable,
        high-performance systems. I design APIs and backend architectures with a focus on
        consistency, reliability, and high-concurrency environments.
      </p>

      <!-- CTAs -->
      <div
        class="flex flex-wrap gap-3 mb-6 animate-fade-up"
        style="animation-delay: 0.3s; opacity: 0; animation-fill-mode: forwards;"
      >
        <a
          href="#projects"
          class="bg-green-500 text-black font-semibold px-5 py-2.5 rounded hover:bg-green-400 transition-colors text-sm"
        >
          view projects
        </a>
        <a
          href="#contact"
          class="border border-green-500/40 text-green-400/80 px-5 py-2.5 rounded hover:bg-green-500/10 hover:text-green-400 hover:border-green-500 transition-colors text-sm"
        >
          get in touch
        </a>
      </div>

      <!-- Social icon buttons -->
      <div
        class="flex gap-3 animate-fade-up"
        style="animation-delay: 0.4s; opacity: 0; animation-fill-mode: forwards;"
      >
        <a
          href="https://github.com/ayus79"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="w-10 h-10 flex items-center justify-center rounded-full border border-[#1e1e1e] bg-[#111111] text-gray-400 hover:text-green-400 hover:border-green-500/50 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/ayush-contractor"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="w-10 h-10 flex items-center justify-center rounded-full border border-[#1e1e1e] bg-[#111111] text-gray-400 hover:text-green-400 hover:border-green-500/50 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="mailto:ayushcon2000@gmail.com"
          aria-label="Email"
          class="w-10 h-10 flex items-center justify-center rounded-full border border-[#1e1e1e] bg-[#111111] text-gray-400 hover:text-green-400 hover:border-green-500/50 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: terminal profile card (desktop only) -->
    <div
      class="hidden lg:block animate-fade-up"
      style="animation-delay: 0.3s; opacity: 0; animation-fill-mode: forwards;"
    >
      <div class="rounded-lg border border-[#1e1e1e] bg-[#111111] overflow-hidden shadow-2xl shadow-green-500/5">
        <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[#1e1e1e] bg-[#0d0d0d]">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
          <span class="ml-3 text-xs text-gray-600">profile.json</span>
        </div>
        <pre class="p-5 text-xs leading-7 text-gray-300 overflow-x-auto"><span class="text-gray-600">{</span>
  <span class="text-cyan-400">"name"</span>: <span class="text-green-400">"Ayush Contractor"</span>,
  <span class="text-cyan-400">"role"</span>: <span class="text-green-400">"Backend Engineer"</span>,
  <span class="text-cyan-400">"stack"</span>: [<span class="text-green-400">"Python"</span>, <span class="text-green-400">"FastAPI"</span>],
  <span class="text-cyan-400">"focus"</span>: [
    <span class="text-green-400">"System Design"</span>,
    <span class="text-green-400">"GenAI & LLM"</span>
  ],
  <span class="text-cyan-400">"location"</span>: <span class="text-green-400">"Ahmedabad, India"</span>,
  <span class="text-cyan-400">"open_to"</span>: <span class="text-green-400">"remote / hybrid"</span>
<span class="text-gray-600">}</span></pre>
      </div>
    </div>
  </div>

  <!-- Stats row (no numbers that need updating) -->
  <div
    class="relative grid grid-cols-3 gap-4 mt-12 md:mt-16 pt-6 border-t border-[#1e1e1e] max-w-2xl animate-fade-up"
    style="animation-delay: 0.5s; opacity: 0; animation-fill-mode: forwards;"
  >
    {stats.map((s) => (
      <div class="min-w-0">
        <p class="text-lg sm:text-2xl font-semibold text-white truncate">{s.value}</p>
        <p class="text-xs text-gray-500 mt-1">{s.label}</p>
      </div>
    ))}
  </div>

  <!-- Scroll hint -->
  <a
    href="#projects"
    class="hidden md:flex absolute bottom-8 right-0 flex-col items-center gap-1 text-xs text-gray-600 hover:text-green-400 transition-colors"
  >
    scroll to explore
    <svg class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </a>
</section>

<script>
  const roles = [
    'Python Backend Engineer',
    'Scalable Systems Builder',
    'Problem Solver',
    'Tech Enthusiast',
    'Part-Time Gamer',
  ];

  let roleIndex = Math.floor(Math.random() * roles.length);
  let charIndex = 0;
  let deleting = false;
  const el = document.getElementById('typewriter')!;

  function tick() {
    const current = roles[roleIndex];
    el.textContent = deleting ? current.slice(0, charIndex--) : current.slice(0, charIndex++);

    if (!deleting && charIndex > current.length) {
      deleting = true;
      setTimeout(tick, 1800);
      return;
    }
    if (deleting && charIndex < 0) {
      deleting = false;
      let next = Math.floor(Math.random() * roles.length);
      if (next === roleIndex) next = (next + 1) % roles.length;
      roleIndex = next;
      charIndex = 0;
    }
    setTimeout(tick, deleting ? 50 : 80);
  }

  tick();
</script>
