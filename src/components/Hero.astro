<section id="about" class="min-h-[calc(100svh-3.5rem)] flex flex-col justify-center py-16 md:py-24">
  <!-- Terminal prompt line -->
  <p class="text-gray-500 text-xs sm:text-sm mb-5 md:mb-6">
    <span class="text-green-400">ayush@dev</span>:<span class="text-cyan-400">~</span>$ whoami
  </p>

  <!-- Name -->
  <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white leading-tight mb-4 animate-fade-up">
    Ayush Contractor<span class="text-green-400">.</span>
  </h1>

  <!-- Role typewriter -->
  <div
    class="text-lg sm:text-xl md:text-2xl text-gray-400 mb-6 md:mb-8 animate-fade-up"
    style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
  >
    <span class="text-green-400">&gt; </span>
    <span id="typewriter"></span><span class="animate-blink text-green-400">█</span>
  </div>

  <!-- Bio -->
  <p
    class="max-w-xl text-gray-400 text-sm sm:text-base leading-relaxed mb-8 md:mb-10 animate-fade-up"
    style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;"
  >
    Backend-focused Software Engineer with strong expertise in Python and building scalable,
    high-performance systems. I design APIs, backend architectures, and data-driven systems
    with a focus on consistency, reliability, and high-concurrency environments.
  </p>

  <!-- CTAs -->
  <div
    class="flex flex-wrap gap-3 animate-fade-up"
    style="animation-delay: 0.3s; opacity: 0; animation-fill-mode: forwards;"
  >
    <a
      href="#projects"
      class="bg-green-500 text-black font-semibold px-5 py-2.5 rounded hover:bg-green-400 transition-colors text-sm"
    >
      view projects
    </a>
    <a
      href="mailto:ayushcon2000@gmail.com"
      class="border border-green-500/40 text-green-400/80 px-5 py-2.5 rounded hover:bg-green-500/10 hover:text-green-400 hover:border-green-500 transition-colors text-sm"
    >
      get in touch
